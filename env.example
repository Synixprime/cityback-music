# ─────────────────────────────────────────
# Fichier de configuration du bot
# Renomme ce fichier en .env (sans .example)
# ─────────────────────────────────────────

# Token de ton bot Discord
# Obtenu sur https://discord.com/developers/applications
DISCORD_TOKEN=ton_token_discord_ici

# Préfixe des commandes (par défaut : !)
PREFIX=!

# Spotify API
# Obtenu sur https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=ton_client_id_spotify_ici
SPOTIFY_CLIENT_SECRET=ton_client_secret_spotify_ici
